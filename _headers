/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/assets/app.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/vendor/*
  Cache-Control: public, max-age=604800
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
